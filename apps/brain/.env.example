# Copy to apps/brain/.env (gitignored). Never commit real keys.
#
# Hermes brain provider — Anthropic direct is fastest for Haiku.
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional alternate providers (Hermes will use whichever matches config.yaml):
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
