# Copy to apps/browser-agent/.env (gitignored). Never commit real keys.
# Port is in repo-root shared.env: BROWSER_AGENT_PORT=9001

# Shared secret. If set, clients must send header X-Jarvis-Key. Required once the
# service is public (Cloudflare tunnel). Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
BROWSER_AGENT_API_KEY=

# mock = labeled demo data, no keys needed | tinyfish = your real Canvas
BROWSER_BACKEND=mock
CACHE_TTL_MINUTES=30
CANVAS_BASE_URL=https://canvas.asu.edu
SYNC_DAYS=14
SYNC_PAST_DAYS=0
# Optional: only these Canvas course ids, comma-separated (empty = courses with work due)
CANVAS_COURSE_IDS=

# Course materials: text is cached in data/materials/ (gitignored, never commit)
MATERIALS_MAX_MB=25
MATERIALS_PREFETCH_DAYS=7
MATERIALS_PREFETCH_LIMIT=12
MATERIALS_PREFETCH_SECONDS=60

# Classification LLM — Gemini. Key: https://aistudio.google.com/apikey
# Without a key the service still works with rules only.
CLASSIFIER_LLM_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.7
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the main model is slow/busy (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# TinyFish. Key: https://agent.tinyfish.ai (API keys)
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
# Your Browser Context Profile signed into Canvas (see README: one-time setup)
TINYFISH_PROFILE_ID=
