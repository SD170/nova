  "materials": [
    {
      "id": "cse310-l9",
      "course_id": "cse310",
      "title": "Lecture 9 - AVL Trees",
      "type": "page",
      "url": "https://canvas.asu.edu/courses/cse310/pages/lecture-9",
      "local_path": null,
      "extracted_text": "An AVL tree is a self-balancing binary search tree. For every node, the heights of the left and right subtrees differ by at most one. After an insert, the tree is rebalanced with single (LL, RR) or double (LR, RL) rotations. Search, insert and delete all run in O(log n)."
    },
    {
      "id": "cse310-l10",
      "course_id": "cse310",
      "title": "Lecture 10 - Heaps",
      "type": "page",
      "url": "https://canvas.asu.edu/courses/cse310/pages/lecture-10",
      "local_path": null,
      "extracted_text": "A binary min-heap is a complete binary tree where each parent is <= its children. Insert bubbles up, extract-min bubbles down; both are O(log n). Build-heap is O(n)."
    },
    {
      "id": "mat343-l12",
      "course_id": "mat343",
      "title": "Lecture 12 - Eigenvalues",
      "type": "page",
      "url": "https://canvas.asu.edu/courses/mat343/pages/lecture-12",
      "local_path": null,
      "extracted_text": "lambda is an eigenvalue of A if Av = lambda v for some nonzero v. Eigenvalues are the roots of det(A - lambda I) = 0, the characteristic polynomial."
    }
  ]
