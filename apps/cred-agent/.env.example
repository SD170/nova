# Student Ed25519 keypair (Solana format, base58). Generate with scripts/gen_keypair.py.
# NEVER commit real keys. .env is gitignored.
STUDENT_PRIVATE_KEY_BASE58=
STUDENT_PUBLIC_KEY_BASE58=

# Solana RPC — devnet is free. Mainnet costs ~0.0001 SOL per credential.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Canvas MCP tunnel (Abishek's browser-agent) — pulled from shared.env if blank.
PUBLIC_CANVAS_BASE=
CANVAS_API_KEY=

# Optional: workspace MCP for future course-completion polling. Not required.
PUBLIC_WORKSPACE_BASE=

# Port
PORT=9010
