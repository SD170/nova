# Student Ed25519 keypair (Solana format, base58). Generate with scripts/gen_keypair.py.
# NEVER commit real keys. .env is gitignored.
STUDENT_PRIVATE_KEY_BASE58=
STUDENT_PUBLIC_KEY_BASE58=

# Solana RPC — devnet is free. Mainnet costs ~0.0001 SOL per credential.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Canvas MCP tunnel (Abishek's browser-agent) — pulled from shared.env if blank.
PUBLIC_CANVAS_BASE=
CANVAS_API_KEY=

# Optional: workspace MCP for future course-completion polling. Not required.
PUBLIC_WORKSPACE_BASE=

# Port
PORT=9010

# ── Cloudflare R2 (optional). Leave blank → service runs in local-only mode.
# Grab these from Cloudflare dashboard → R2:
#   - account id    (sidebar, upper right)
#   - bucket name   (you create)
#   - API token with Object Read & Write → access key + secret
#   - public URL    (pub-<hash>.r2.dev OR a custom domain you attach)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for objects. Example:
#   https://pub-abc123def456.r2.dev
#   https://credentials.yourdomain.com
R2_PUBLIC_BASE=
