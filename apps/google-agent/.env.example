# Copy to apps/google-agent/.env (gitignored). Never commit real keys.
# Port: WORKSPACE_PORT=9005 in repo-root shared.env

# Same shared secret as the Canvas service. If set, clients must send header
# X-Canvas-Key (also used by this service to read your Canvas to-dos on localhost:9001).
CANVAS_API_KEY=

# mock = labeled demo inbox + calendar, no Google login | google = your real account
WORKSPACE_BACKEND=mock

# Where the Canvas service (apps/browser-agent) runs, for Canvas -> Calendar sync
CANVAS_SERVICE_URL=http://localhost:9001

# Public tunnel URL of THIS service (used in download links for saved documents)
PUBLIC_WORKSPACE_BASE=

TIMEZONE=America/Phoenix
NOVA_CALENDAR_NAME=Nova
# Background Canvas -> Calendar sync every N minutes (only after calendar_auto_sync is switched on)
AUTO_SYNC_MINUTES=20

# Gemini: classifies mail (important / needs reply) and summarizes company research.
# Without a key the service falls back to rules and raw search results.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# TinyFish (company research). Same key as apps/browser-agent.
TINYFISH_API_KEY=
