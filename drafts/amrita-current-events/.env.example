# Copy to .env (gitignored). Never commit real keys. Everything works with all of these blank.

# Shared secret for the brain-facing tool endpoints (header X-Jarvis-Key). Set it before exposing a public URL.
NEWS_AGENT_API_KEY=

# ── Optional keyed news APIs — each one switches on automatically when its key is set ──
# The Guardian Open Platform — free developer key, instant: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# New York Times Top Stories — free: https://developer.nytimes.com/get-started (enable "Top Stories API")
NYT_API_KEY=
# GNews — 100 requests/day free: https://gnews.io/register
GNEWS_API_KEY=
# NewsData.io — 200 credits/day free: https://newsdata.io/register
NEWSDATA_API_KEY=
# NewsAPI.org — free developer plan works on localhost only: https://newsapi.org/register
NEWSAPI_KEY=

# ── Optional tuning ──
# NEWS_PORT=9004
# NEWS_CACHE_TTL_MINUTES=15
# NEWS_SINCE_HOURS=24
# PUSH_INTERVAL_SECONDS=600
# PUSH_ENABLED=1
