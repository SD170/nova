# Copy to .env (gitignored). The Vite dev server picks VITE_* vars up at build/dev time.
#
# Public key (safe to ship in a browser build); assistant id is just a UUID, also safe.
# Both live in the repo-root shared.env + apps/voice/.env — paste the current values here.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
# Optional: Shruti student-persona assistant for persona switch demo
VITE_VAPI_SHRUTI_ASSISTANT_ID=
