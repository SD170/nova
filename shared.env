# Shared non-secret config — committed, visible to every service.
# Secrets (API keys, tokens) do NOT go here; they live in each app's local .env (gitignored).
#
# Any service can source this file:
#   set -a && . ../../shared.env && set +a    # from apps/<name>/
# Or in Python:  dotenv.load_dotenv("../../shared.env")

# ── Voice (Vapi) ───────────────────────────────────────────────
# Student Jarvis assistant, created 2026-11-14.
VAPI_ASSISTANT_ID=f6bd0e01-6592-4ff9-98e8-4a90456441a9
VAPI_ASSISTANT_NAME="Student Jarvis"
VAPI_DASHBOARD_URL=https://dashboard.vapi.ai/assistants/f6bd0e01-6592-4ff9-98e8-4a90456441a9

# ── Public webhook (Cloudflare quick tunnel → laptop:7070) ─────
# ⚠ Ephemeral: changes every time we restart `cloudflared tunnel`.
# Update this whenever the tunnel is relaunched.
PUBLIC_WEBHOOK_BASE=https://chance-flip-copying-exercise.trycloudflare.com
PUBLIC_VAPI_WEBHOOK=https://chance-flip-copying-exercise.trycloudflare.com/vapi

# ── Canvas service (Abishek, apps/browser-agent :9001) ─────────
# Cloudflare quick tunnel; changes every restart. Needs header X-Jarvis-Key
# (key is NOT in the repo; ask Abishek).
PUBLIC_CANVAS_BASE=https://establish-editorials-template-occupations.trycloudflare.com

# ── Local service ports (all run on laptop during dev) ────────
VOICE_WEBHOOK_PORT=7070
ORCHESTRATOR_PORT=8000
BROWSER_AGENT_PORT=9001
RETRIEVAL_QUIZ_PORT=9002
# add more as services land
